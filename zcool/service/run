#!/bin/sh
exec 2>&1
# MSI laptops: zcool reaches the embedded controller through ec_sys, which lives in debugfs
if grep -qs Micro-Star /sys/class/dmi/id/sys_vendor; then
	mountpoint -q /sys/kernel/debug || mount -t debugfs -o nosuid,nodev,noexec debugfs /sys/kernel/debug 2>/dev/null
	modprobe -q ec_sys write_support=1
fi
exec /usr/local/bin/zcool run
