# /etc/zcool.conf. Run `zcool list` to see the chips on this machine and their defaults.
# Lines left out use the default, which stays well below each chip's critical point.

# The most each chip may reach, in degrees C. A value above its safe range is lowered.
# cpu0.max = 85
# gpu0.max = 80
# nvme0.max = 65

# A GPU that does not show the boot screen sleeps when idle. If one misbehaves
# waking up, keep them all awake:
# gpu.sleep = no

# Fans zcool must never touch. It already never goes below the speed the firmware
# had set, so this is for fans you simply want left alone.
# fan.exclude = nct6798/pwm3

# Stop charging the battery at this percent: it lives longer. Stays set when zcool stops.
# battery.max = 80

# What follows the power source: `.ac` on mains, `.battery` on battery. Left out, the
# firmware's own stays. `zcool menu` sets them all at once with its presets.
# The CPU's energy preference: performance, balance_performance, balance_power, power.
# epp.ac = balance_performance
# epp.battery = balance_power
# Clocks above the base clock: off on battery for a cool laptop that lasts longer.
# turbo.battery = no
# quiet: up to 15% of power goes before the fans go past the firmware's curve.
# noise.battery = quiet
# Every limit lower by this many degrees.
# limits.battery = -10

# MSI laptops: the EC's own power profile (eco, comfort, sport, turbo) per power source,
# and `ec = no` to keep zcool away from the EC altogether. See the README.
# mode.ac = comfort
# mode.battery = eco
# ec = no

# zcool learns how much power the cooler carries at the limit and starts there next time.
# learn = no

# An MSI EC's silent fan curve while every chip is far below its limit.
# fan.silent = no

# Under work heavier than the machine can do: jobs yield the CPU to the desktop, and a
# process about to starve memory is ended before the system stalls. See the README.
# guard.cpu = no
# guard.memory = no

# Undervolting, Intel only, and only with kernel lockdown off: read the README first.
# In the BIOS is the better place for it, on Intel and on AMD.
# undervolt.core = -50
# undervolt.cache = -50
