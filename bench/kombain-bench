#!/bin/sh
# kombain-bench: real measurements of this machine, before and after a change, so that
# "faster", "lighter" and "quieter" are numbers. Every run appends a row to a CSV in the
# results directory; `summary` prints medians and p95 per label. The method: bench/README.md.
#
#   kombain-bench boot [--label L] [--from DIR]            this boot's stages, firmware to desktop (root)
#   kombain-bench idle [--seconds N] [--label L]           wakeups, memory, power at rest (more as root)
#   kombain-bench jitter [--seconds N] [--hz N] [--label L]  how late a 144 Hz task wakes, nothing else running
#   kombain-bench build [--jobs N] [--runs N] [--tree DIR] [--label L]
#                                                          a C build: seconds, joules, the desktop's jitter under it
#                                                          (as root it reads the joules and still builds as the tree's owner)
#   kombain-bench game FILE.csv [--label L]                a MangoHud log: frame times
#   kombain-bench battery [--minutes N] [--label L]        watts from the battery while you use the machine
#   kombain-bench sched [--with LIST] [--rounds N] [--seconds N] [--jobs N] [--runs N] [--tree DIR] [--cool C]
#                                                          schedulers in turns (root): jitter and build under each;
#                                                          stock, a sched_ext one by name (scx_lavd) or NAME=COMMAND
#   kombain-bench summary [FILE...]                        medians and p95 of what was measured, per label
#   kombain-bench mark NAME                                writes a marker (the session does, see README)
#
# Results go to $KOMBAIN_BENCH_DIR, by default /var/tmp/kombain-bench. The label of a row is
# what you compare: by default the kernel and PID 1, like 6.18.59_1/runit.
set -u

dir=${KOMBAIN_BENCH_DIR:-/var/tmp/kombain-bench}
zjitter=${ZJITTER:-zjitter}

usage() {
	sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
	exit "$1"
}

die() {
	echo "kombain-bench: $*" >&2
	exit 1
}

uptime_s() {
	cut -d' ' -f1 /proc/uptime
}

init_name() {
	cat /proc/1/comm 2>/dev/null || echo '?'
}

mode() {
	if grep -qw gaming /proc/cmdline 2>/dev/null; then echo gaming; else echo dev; fi
}

power_source() {
	for s in /sys/class/power_supply/*; do
		[ -e "$s/type" ] || continue
		if [ "$(cat "$s/type")" = Mains ]; then
			if [ "$(cat "$s/online" 2>/dev/null)" = 1 ]; then echo mains; else echo battery; fi
			return
		fi
	done
	echo mains
}

label=
set_label() {
	[ -n "$label" ] || label="$(uname -r)/$(init_name)"
}

own_dir=${XDG_DATA_HOME:-$HOME/.local/share}/kombain-bench
moved=

# row FILE HEADER VALUES: appends one row, the header first when the file is new. Root makes the
# directory everyone's, as /tmp is, and its files writable by all; a user who still cannot write
# there (the directory or the file is root's from before) writes in their own and says so.
row() {
	f=$dir/$1
	if ! mkdir -p "$dir" 2>/dev/null || ! [ -w "$dir" ] || { [ -e "$f" ] && ! [ -w "$f" ]; }; then
		dir=$own_dir
		mkdir -p "$dir" 2>/dev/null || die "cannot create $dir"
		f=$dir/$1
		[ -n "$moved" ] || echo "  (${KOMBAIN_BENCH_DIR:-/var/tmp/kombain-bench} is root's: rows go to $dir; summary reads both)"
		moved=1
	fi
	[ "$(id -u)" -ne 0 ] || chmod 1777 "$dir" 2>/dev/null
	header="label,utc,kernel,init,mode,source,$2"
	if [ -e "$f" ] && [ "$(head -1 "$f")" != "$header" ]; then
		# older rows with other columns stay readable beside the new file
		mv "$f" "$f.old-$(date -u +%Y%m%d%H%M%S)"
		echo "  (the columns of $(basename "$f") changed: the old rows were moved aside)"
	fi
	if [ ! -e "$f" ]; then
		echo "$header" > "$f"
		[ "$(id -u)" -ne 0 ] || chmod 666 "$f" 2>/dev/null
	fi
	echo "$label,$(date -u +%Y-%m-%dT%H:%M:%SZ),$(uname -r),$(init_name),$(mode),$(power_source),$3" >> "$f"
	echo "  -> $f"
}

# The value at rank ceil(p*n) of sorted numbers on stdin; "-" when there are none.
rank() {
	sort -n | awk -v p="$1" '{ v[NR] = $1 } END { if (NR == 0) { print "-"; exit } r = int(p * NR + 0.999999); if (r < 1) r = 1; print v[r] }'
}

num() {
	awk -v a="$1" -v b="$2" -v op="$3" 'BEGIN { if (a == "-" || b == "-") { print "-"; exit } if (op == "-") printf "%.2f\n", a - b; else if (op == "/") printf "%.2f\n", (b == 0 ? 0 : a / b); else printf "%.2f\n", a + b }'
}

# ---------------------------------------------------------------- boot

boot() {
	from=
	while [ $# -gt 0 ]; do
		case $1 in
		--label) label=$2; shift ;;
		--from) from=$2; shift ;;
		*) usage 2 ;;
		esac
		shift
	done
	set_label
	dmesg_note=
	if [ -n "$from" ]; then
		dmesg_text=$(cat "$from/dmesg.txt" 2>/dev/null) || dmesg_note="no kernel log in $from"
		fpdt=$from/fpdt
		markers=$from/markers
		session=$from/markers/session-start
		desktop=$from/markers/desktop-ready
	else
		dmesg_note=
		if ! dmesg_text=$(dmesg -k 2>/dev/null); then
			dmesg_text=
			if [ "$(id -u)" -ne 0 ]; then
				dmesg_note="the kernel log is root's here (kernel.dmesg_restrict): doas kombain-bench boot reads it"
			else
				dmesg_note="the kernel log cannot be read here (a container?)"
			fi
		fi
		fpdt=/sys/firmware/acpi/fpdt/boot
		markers=/run/kombain-bench
		session=$(ls /run/user/*/kombain-session-start 2>/dev/null | head -1)
		desktop=$(ls /run/user/*/kombain-desktop-ready 2>/dev/null | head -1)
	fi
	# "Run /init as init process" with an initramfs, "/sbin/init" without one
	kernel_s=$(printf '%s\n' "$dmesg_text" | sed -n 's/^\[ *\([0-9.]*\)\] Run [^ ]* as init process.*/\1/p' | head -1)
	[ -n "$kernel_s" ] || kernel_s=-
	firmware_s=-
	if [ -r "$fpdt/firmware_start_ns" ] && [ -r "$fpdt/exitbootservice_end_ns" ]; then
		firmware_s=$(awk -v a="$(cat "$fpdt/exitbootservice_end_ns")" -v b="$(cat "$fpdt/firmware_start_ns")" 'BEGIN { printf "%.2f\n", (a - b) / 1e9 }')
	fi
	s1_start=$(cat "$markers/stage1-start" 2>/dev/null || echo -)
	s1_end=$(cat "$markers/stage1-end" 2>/dev/null || echo -)
	login=$(login_at "$from")
	sess=$(cat "$session" 2>/dev/null || echo -)
	desk=$(cat "$desktop" 2>/dev/null || echo -)
	up=$desk
	[ "$up" = - ] && up=$sess
	initrd_s=$(num "$s1_start" "$kernel_s" -)
	stage1_s=$(num "$s1_end" "$s1_start" -)
	login_s=$(num "$login" "$s1_end" -)
	session_s=$(num "$sess" "$login" -)
	panel_s=$(num "$desk" "$sess" -)
	echo "boot ($label):"
	echo "  firmware (ACPI FPDT, reset to the loader)   $firmware_s s"
	echo "  kernel, until it ran the initramfs          $kernel_s s"
	echo "  initramfs, LUKS and your passphrase          $initrd_s s   (includes the typing: compare with care)"
	echo "  stage 1 (runit core-services)                $stage1_s s"
	echo "  stage 2 until the login on tty1              $login_s s"
	echo "  login until the session started              $session_s s"
	echo "  the session until the panel was up           $panel_s s"
	echo "  uptime when the desktop was up               $up s"
	[ -z "$dmesg_note" ] || echo "  $dmesg_note"
	if [ "$s1_start" = - ]; then
		echo "  no stage 1 markers of this boot: they come with the next boot (install.sh put them in /etc/runit/core-services)"
	fi
	[ "$login" != - ] || echo "  no tty login in utmp: a display manager, or utmpdump is missing"
	if [ "$sess" = - ] || [ "$desk" = - ]; then
		echo "  no session marker: see bench/README.md, 'markers' (the session writes one at login and one when the panel is up)"
	fi
	row boot.csv "firmware_s,kernel_s,initrd_luks_s,stage1_s,services_login_s,login_session_s,session_desktop_s,uptime_at_desktop_s" "$firmware_s,$kernel_s,$initrd_s,$stage1_s,$login_s,$session_s,$panel_s,$up"
}

# The uptime at the first login on a console, from utmp: when the getty had let the user in. Its
# stamp is wall-clock time with microseconds; the boot's wall-clock time is now minus the uptime,
# so this is good to about a second.
login_at() {
	if [ -n "$1" ]; then
		cat "$1/markers/login" 2>/dev/null || echo -
		return
	fi
	command -v utmpdump >/dev/null 2>&1 || { echo -; return; }
	stamp=$(utmpdump /var/run/utmp 2>/dev/null | awk -F'[][]' '$2 == "7" && $6 ~ /^tty[0-9]+ *$/ { if (s == "") s = $16 } END { print s }')
	[ -n "$stamp" ] || { echo -; return; }
	epoch=$(date -d "$(echo "$stamp" | sed 's/,[0-9]*//')" +%s 2>/dev/null)
	[ -n "$epoch" ] || { echo -; return; }
	awk -v e="$epoch" -v now="$(date +%s)" -v up="$(uptime_s)" 'BEGIN { printf "%.2f\n", e - (now - up) }'
}

# ---------------------------------------------------------------- idle

stat_field() {
	# stat_field NAME INDEX: a field of /proc/stat's line NAME
	awk -v name="$1" -v i="$2" '$1 == name { print $(i + 1); exit }' /proc/stat
}

cpu_busy_jiffies() {
	awk '$1 == "cpu" { print $2 + $3 + $4 + $7 + $8; exit }' /proc/stat
}

cpu_all_jiffies() {
	awk '$1 == "cpu" { s = 0; for (i = 2; i <= NF; i++) s += $i; print s; exit }' /proc/stat
}

rapl_uj() {
	cat /sys/class/powercap/intel-rapl:0/energy_uj 2>/dev/null || echo -
}

battery_w() {
	for b in /sys/class/power_supply/*; do
		[ "$(cat "$b/type" 2>/dev/null)" = Battery ] || continue
		[ "$(cat "$b/status" 2>/dev/null)" = Discharging ] || { echo -; return; }
		if [ -r "$b/power_now" ]; then
			awk -v p="$(cat "$b/power_now")" 'BEGIN { printf "%.2f\n", p / 1e6 }'
		elif [ -r "$b/current_now" ] && [ -r "$b/voltage_now" ]; then
			awk -v c="$(cat "$b/current_now")" -v v="$(cat "$b/voltage_now")" 'BEGIN { printf "%.2f\n", c * v / 1e12 }'
		else
			echo -
		fi
		return
	done
	echo -
}

pss_mib() {
	[ "$(id -u)" -eq 0 ] || { echo -; return; }
	# one process at a time: a process gone between the glob and the read must not end the sum
	for f in /proc/[0-9]*/smaps_rollup; do cat "$f" 2>/dev/null; done | awk '/^Pss:/ { s += $2 } END { printf "%.0f\n", s / 1024 }'
}

idle() {
	seconds=60
	while [ $# -gt 0 ]; do
		case $1 in
		--seconds) seconds=$2; shift ;;
		--label) label=$2; shift ;;
		*) usage 2 ;;
		esac
		shift
	done
	set_label
	echo "idle ($label): $seconds s, leave the machine alone"
	i0=$(stat_field intr 1); c0=$(stat_field ctxt 1); b0=$(cpu_busy_jiffies); a0=$(cpu_all_jiffies); e0=$(rapl_uj)
	bat_samples=$(mktemp)
	t=0
	while [ "$t" -lt "$seconds" ]; do
		sleep 5
		t=$((t + 5))
		battery_w >> "$bat_samples"
	done
	i1=$(stat_field intr 1); c1=$(stat_field ctxt 1); b1=$(cpu_busy_jiffies); a1=$(cpu_all_jiffies); e1=$(rapl_uj)
	wakeups=$(awk -v a="$i1" -v b="$i0" -v s="$seconds" 'BEGIN { printf "%.0f\n", (a - b) / s }')
	ctxt=$(awk -v a="$c1" -v b="$c0" -v s="$seconds" 'BEGIN { printf "%.0f\n", (a - b) / s }')
	# the parentheses matter: a bare > in a printf list is awk's output redirection
	busy=$(awk -v b0="$b0" -v b1="$b1" -v a0="$a0" -v a1="$a1" 'BEGIN { d = a1 - a0; printf "%.1f\n", (d > 0 ? 100 * (b1 - b0) / d : 0) }')
	rapl=-
	[ "$e0" != - ] && [ "$e1" != - ] && rapl=$(awk -v a="$e1" -v b="$e0" -v s="$seconds" 'BEGIN { printf "%.2f\n", (a - b) / 1e6 / s }')
	bat=$(grep -v '^-$' "$bat_samples" | rank 0.5)
	rm -f "$bat_samples"
	mem=$(awk '/^MemAvailable:/ { printf "%.0f\n", $2 / 1024 }' /proc/meminfo)
	pss=$(pss_mib)
	echo "  interrupts per second     $wakeups"
	echo "  context switches per s    $ctxt"
	echo "  CPU busy                  $busy %"
	echo "  memory available          $mem MiB"
	echo "  memory in use (PSS)       $pss MiB$([ "$pss" = - ] && echo '   (root sees it: doas kombain-bench idle)')"
	echo "  CPU package power (RAPL)  $rapl W$([ "$rapl" = - ] && echo '   (root reads it)')"
	echo "  battery power             $bat W$([ "$bat" = - ] && echo '   (on mains, or no battery)')"
	row idle.csv "seconds,wakeups_per_s,ctxt_per_s,cpu_busy_pct,mem_available_mib,pss_mib,rapl_w,battery_w" "$seconds,$wakeups,$ctxt,$busy,$mem,$pss,$rapl,$bat"
}

# ---------------------------------------------------------------- jitter

jitter() {
	seconds=30; hz=144
	while [ $# -gt 0 ]; do
		case $1 in
		--seconds) seconds=$2; shift ;;
		--hz) hz=$2; shift ;;
		--label) label=$2; shift ;;
		*) usage 2 ;;
		esac
		shift
	done
	set_label
	command -v "$zjitter" >/dev/null || die "zjitter is not installed (install.sh builds it)"
	echo "jitter ($label): $hz Hz for $seconds s, nothing else running"
	line=$("$zjitter" --hz "$hz" --seconds "$seconds" --csv) || die "zjitter failed"
	echo "  hz,seconds,wakes,misses,p50_us,p99_us,max_us = $line"
	row jitter.csv "hz,seconds,wakes,misses,p50_us,p99_us,max_us,load" "$line,none"
}

# ---------------------------------------------------------------- build

build() {
	jobs=$(nproc 2>/dev/null || echo 4); runs=3; tree=${KOMBAIN_SRC:-$HOME/kombain}/fdash
	while [ $# -gt 0 ]; do
		case $1 in
		--jobs) jobs=$2; shift ;;
		--runs) runs=$2; shift ;;
		--tree) tree=$2; shift ;;
		--label) label=$2; shift ;;
		*) usage 2 ;;
		esac
		shift
	done
	set_label
	[ -f "$tree/Makefile" ] || die "no Makefile in $tree: --tree DIR, or KOMBAIN_SRC=/path/to/kombain"
	command -v "$zjitter" >/dev/null || die "zjitter is not installed (install.sh builds it)"
	# as root (doas kombain-bench build) the package's joules are readable, and make runs as the
	# tree's owner, so that no root-owned object lands in a checkout
	owner=$(stat -c %u "$tree")
	as_owner=
	if [ "$(id -u)" -eq 0 ] && [ "$owner" -ne 0 ]; then
		as_owner="setpriv --reuid=$owner --regid=$(stat -c %g "$tree") --init-groups env HOME=$(getent passwd "$owner" | cut -d: -f6)"
		[ "$(rapl_uj)" != - ] || echo "  (no RAPL here: joules stay unknown)"
	elif [ "$(rapl_uj)" = - ]; then
		echo "  (as a user the package's joules are not readable: doas kombain-bench build reads them and still builds as you)"
	fi
	echo "build ($label): make -j$jobs in $tree, $runs runs after a warm-up; zjitter at 144 Hz beside it"
	r=0
	while [ "$r" -le "$runs" ]; do
		$as_owner make -C "$tree" clean >/dev/null 2>&1
		jit=$(mktemp)
		"$zjitter" --hz 144 --seconds 3600 --csv > "$jit" &
		jpid=$!
		e0=$(rapl_uj)
		t0=$(date +%s.%N)
		if ! $as_owner env CCACHE_DISABLE=1 make -C "$tree" -j"$jobs" >/dev/null 2>&1; then
			kill -TERM "$jpid" 2>/dev/null; wait "$jpid" 2>/dev/null; rm -f "$jit"
			die "the build failed in $tree"
		fi
		t1=$(date +%s.%N)
		e1=$(rapl_uj)
		kill -TERM "$jpid" 2>/dev/null
		wait "$jpid" 2>/dev/null
		seconds=$(awk -v a="$t1" -v b="$t0" 'BEGIN { printf "%.1f\n", a - b }')
		joules=-
		[ "$e0" != - ] && [ "$e1" != - ] && joules=$(awk -v a="$e1" -v b="$e0" 'BEGIN { printf "%.0f\n", (a - b) / 1e6 }')
		jl=$(cat "$jit"); rm -f "$jit"
		misses=$(echo "$jl" | cut -d, -f4); p99=$(echo "$jl" | cut -d, -f6); max=$(echo "$jl" | cut -d, -f7)
		if [ "$r" -eq 0 ]; then
			echo "  warm-up: $seconds s (discarded)"
		else
			echo "  run $r: $seconds s, $joules J, desktop jitter: $misses frames missed, p99 $p99 us, max $max us"
			row build.csv "jobs,run,seconds,joules,jitter_misses,jitter_p99_us,jitter_max_us" "$jobs,$r,$seconds,$joules,$misses,$p99,$max"
		fi
		r=$((r + 1))
	done
	$as_owner make -C "$tree" clean >/dev/null 2>&1
}

# ---------------------------------------------------------------- game

game() {
	file=
	while [ $# -gt 0 ]; do
		case $1 in
		--label) label=$2; shift ;;
		-*) usage 2 ;;
		*) file=$1 ;;
		esac
		shift
	done
	[ -n "$file" ] && [ -r "$file" ] || die "game FILE.csv: a MangoHud log (MANGOHUD_CONFIG=output_folder=DIR, F2 in the game)"
	set_label
	# MangoHud: some lines of system facts, then a header with "frametime" and the rows
	frametimes=$(awk -F, 'col == 0 { for (i = 1; i <= NF; i++) if ($i == "frametime") col = i; next } col > 0 && $col ~ /^[0-9.]+$/ { print $col }' "$file")
	n=$(printf '%s\n' "$frametimes" | grep -c .)
	[ "$n" -gt 0 ] || die "$file: no frametime column"
	stats=$(printf '%s\n' "$frametimes" | sort -n | awk '{ v[NR] = $1; s += $1 } END {
		r50 = int(0.50 * NR + 0.999999); r99 = int(0.99 * NR + 0.999999); if (r50 < 1) r50 = 1; if (r99 < 1) r99 = 1
		worst = int(0.01 * NR + 0.999999); if (worst < 1) worst = 1
		ws = 0; for (i = NR - worst + 1; i <= NR; i++) ws += v[i]
		printf "%d,%.1f,%.1f,%.2f,%.2f,%.2f\n", NR, 1000 * NR / s, 1000 * worst / ws, v[r50], v[r99], v[NR] }')
	echo "game ($label): $file"
	echo "  frames,avg_fps,low1_fps,p50_ms,p99_ms,max_ms = $stats"
	row game.csv "file,frames,avg_fps,low1_fps,p50_ms,p99_ms,max_ms" "$(basename "$file"),$stats"
}

# ---------------------------------------------------------------- battery

battery() {
	minutes=10
	while [ $# -gt 0 ]; do
		case $1 in
		--minutes) minutes=$2; shift ;;
		--label) label=$2; shift ;;
		*) usage 2 ;;
		esac
		shift
	done
	set_label
	[ "$(battery_w)" != - ] || die "not discharging: unplug the charger first"
	echo "battery ($label): $minutes min, use the machine as you mean to measure it"
	samples=$(mktemp)
	t=0
	while [ "$t" -lt $((minutes * 60)) ]; do
		sleep 5
		t=$((t + 5))
		battery_w >> "$samples"
	done
	med=$(grep -v '^-$' "$samples" | rank 0.5)
	p95=$(grep -v '^-$' "$samples" | rank 0.95)
	rm -f "$samples"
	bright=-
	for b in /sys/class/backlight/*; do
		[ -r "$b/brightness" ] && bright=$(awk -v a="$(cat "$b/brightness")" -v m="$(cat "$b/max_brightness")" 'BEGIN { printf "%.0f\n", 100 * a / m }') && break
	done
	hours=-
	for b in /sys/class/power_supply/*; do
		[ "$(cat "$b/type" 2>/dev/null)" = Battery ] || continue
		if [ -r "$b/energy_now" ] && [ "$med" != - ]; then
			hours=$(awk -v e="$(cat "$b/energy_now")" -v w="$med" 'BEGIN { printf "%.1f\n", w > 0 ? e / 1e6 / w : 0 }')
		fi
		break
	done
	echo "  battery power    $med W (median), $p95 W (p95)"
	echo "  brightness       $bright %"
	echo "  at this rate     $hours h left"
	row battery.csv "minutes,median_w,p95_w,brightness_pct,hours_left" "$minutes,$med,$p95,$bright,$hours"
}

# ---------------------------------------------------------------- sched

# The kernel's own account of sched_ext: state (enabled/disabled) and root/ops, the name of the
# scheduler running. A test points it at a fixture.
sched_ext=${KOMBAIN_SCHED_EXT:-/sys/kernel/sched_ext}

sched_state() {
	cat "$sched_ext/state" 2>/dev/null || echo none
}

sched_ops() {
	cat "$sched_ext/root/ops" 2>/dev/null || echo -
}

# The CPU package's temperature in whole degrees: the x86_pkg_temp zone, else the first sensor
# of coretemp or k10temp; "-" where there is none (a VM, a container).
pkg_temp_c() {
	for z in /sys/class/thermal/thermal_zone*; do
		[ "$(cat "$z/type" 2>/dev/null)" = x86_pkg_temp ] || continue
		awk -v t="$(cat "$z/temp")" 'BEGIN { printf "%.0f\n", t / 1000 }'
		return
	done
	for h in /sys/class/hwmon/hwmon*; do
		case $(cat "$h/name" 2>/dev/null) in
		coretemp|k10temp|zenpower)
			[ -r "$h/temp1_input" ] || continue
			awk -v t="$(cat "$h/temp1_input")" 'BEGIN { printf "%.0f\n", t / 1000 }'
			return ;;
		esac
	done
	echo -
}

# cool_down C: the method's rule that a build starts with the package below C degrees. Waits up
# to 10 minutes; "off" or 0 skips it, and so does a machine without a readable temperature.
cool_down() {
	[ "$1" != off ] && [ "$1" != 0 ] || return 0
	t=$(pkg_temp_c)
	[ "$t" != - ] || { echo "  (no package temperature here: not waiting to cool)"; return 0; }
	waited=0
	while [ "$t" != - ] && [ "$t" -gt "$1" ] && [ "$waited" -lt 600 ]; do
		[ "$waited" -gt 0 ] || printf '  cooling below %s C (now %s C)' "$1" "$t"
		sleep 5
		waited=$((waited + 5))
		t=$(pkg_temp_c)
	done
	[ "$waited" -eq 0 ] || echo " ... $t C after $waited s"
}

# A variant is NAME or NAME=COMMAND. `stock` is the kernel's own scheduler (EEVDF). A bare name
# is a scheduler on PATH, run as it is (scx_lavd, scx_bpfland); a command runs as root until it
# gets SIGTERM, which every sched_ext scheduler takes as "unload and leave" (vh-sched=vh-sched run,
# lavd-perf=scx_lavd --performance). Commands hold no commas: commas separate variants.
variant_name() {
	printf '%s\n' "${1%%=*}"
}

variant_cmd() {
	case $1 in
	*=*) printf '%s\n' "${1#*=}" ;;
	*) printf '%s\n' "$1" ;;
	esac
}

sched_pid=
sched_log=

# sched_start NAME COMMAND: runs the scheduler in the background and waits, up to 30 s, for the
# kernel to say it runs. Its output goes to sched-NAME.log in the results directory.
sched_start() {
	sched_log=$dir/sched-$1.log
	mkdir -p "$dir" 2>/dev/null
	[ -w "$dir" ] || sched_log=$(mktemp)
	sh -c "exec $2" </dev/null >"$sched_log" 2>&1 &
	sched_pid=$!
	waited=0
	while [ "$(sched_state)" != enabled ] && [ "$waited" -lt 30 ]; do
		kill -0 "$sched_pid" 2>/dev/null || break
		sleep 1
		waited=$((waited + 1))
	done
	if [ "$(sched_state)" != enabled ]; then
		echo "  $1 did not take the CPUs over in $waited s; it said:" >&2
		tail -5 "$sched_log" >&2
		sched_stop
		die "cannot run $1"
	fi
	echo "  the kernel runs $(sched_ops) ($1); its log: $sched_log"
	sleep 3
}

# sched_running NAME: dies when the scheduler we started is gone or the kernel dropped it, since
# whatever was measured meanwhile ran under the kernel's own scheduler.
sched_running() {
	[ -n "$sched_pid" ] || return 0
	if ! kill -0 "$sched_pid" 2>/dev/null || [ "$(sched_state)" != enabled ]; then
		echo "  $1 stopped during the run (its log: $sched_log); the rows just written under its label did not run under it: remove them" >&2
		die "$1 stopped"
	fi
}

# sched_stop: ends the scheduler we started and waits for the kernel to be back on its own.
sched_stop() {
	[ -n "$sched_pid" ] || return 0
	kill -TERM "$sched_pid" 2>/dev/null
	wait "$sched_pid" 2>/dev/null
	sched_pid=
	waited=0
	while [ "$(sched_state)" = enabled ] && [ "$waited" -lt 10 ]; do
		sleep 1
		waited=$((waited + 1))
	done
	[ "$(sched_state)" != enabled ] || echo "  the kernel still runs $(sched_ops) after 10 s" >&2
}

sched() {
	# its own names: jitter and build set seconds, jobs, runs and tree themselves
	with=stock,scx_lavd,scx_bpfland,scx_flash; s_rounds=5; s_seconds=30; s_runs=1; cool=50
	s_jobs=$(nproc 2>/dev/null || echo 4); s_tree=${KOMBAIN_SRC:-$HOME/kombain}/fdash
	while [ $# -gt 0 ]; do
		case $1 in
		--with) with=$2; shift ;;
		--rounds) s_rounds=$2; shift ;;
		--seconds) s_seconds=$2; shift ;;
		--jobs) s_jobs=$2; shift ;;
		--runs) s_runs=$2; shift ;;
		--tree) s_tree=$2; shift ;;
		--cool) cool=$2; shift ;;
		*) usage 2 ;;
		esac
		shift
	done
	# the variants, split on commas only (a command keeps its spaces)
	old_ifs=$IFS
	IFS=,
	set -f
	# shellcheck disable=SC2086
	set -- $with
	set +f
	IFS=$old_ifs
	[ $# -ge 1 ] || usage 2
	[ -f "$s_tree/Makefile" ] || die "no Makefile in $s_tree: --tree DIR, or KOMBAIN_SRC=/path/to/kombain"
	command -v "$zjitter" >/dev/null || die "zjitter is not installed (install.sh builds it)"
	# everything a variant needs is checked before the first measurement, not an hour in
	names=
	for v in "$@"; do
		name=$(variant_name "$v")
		names="$names${names:+, }$name"
		[ "$name" != stock ] || continue
		if [ "$sched_ext" = /sys/kernel/sched_ext ]; then
			[ "$(id -u)" -eq 0 ] || die "loading a scheduler needs root: doas kombain-bench sched"
			[ -e "$sched_ext/state" ] || die "this kernel has no sched_ext (no /sys/kernel/sched_ext): the stock Void kernel does not, kombain's does (kernel/README.md)"
		fi
		exe=$(variant_cmd "$v" | awk '{ print $1; exit }')
		command -v "$exe" >/dev/null || die "$name: $exe is not installed (Void: xbps-install scx; or NAME=COMMAND)"
	done
	[ "$(sched_state)" != enabled ] || die "a scheduler is already running ($(sched_ops)): stop it first, the comparison starts from the kernel's own"
	trap 'sched_stop' EXIT
	trap 'sched_stop; trap - EXIT; exit 130' INT TERM
	cooling="cool below $cool C"
	[ "$cool" != off ] && [ "$cool" != 0 ] || cooling="no wait to cool"
	echo "sched: $s_rounds rounds, each under $names in turn: $cooling, jitter for $s_seconds s, a warm-up build and $s_runs build(s) with make -j$s_jobs"
	echo "  the label of a row is the kernel and the variant, like $(uname -r)/$(variant_name "$1")"
	round=1
	while [ "$round" -le "$s_rounds" ]; do
		for v in "$@"; do
			name=$(variant_name "$v")
			lab=$(uname -r)/$name
			echo "round $round, $name:"
			if [ "$name" = stock ]; then
				[ "$(sched_state)" != enabled ] || die "a scheduler is running ($(sched_ops)) where the kernel's own should"
				echo "  the kernel's own scheduler"
			else
				sched_start "$name" "$(variant_cmd "$v")"
			fi
			cool_down "$cool"
			jitter --label "$lab" --seconds "$s_seconds"
			sched_running "$name"
			build --label "$lab" --jobs "$s_jobs" --runs "$s_runs" --tree "$s_tree"
			sched_running "$name"
			sched_stop
		done
		# the next round starts with the next variant, so that no variant always follows the same one
		first=$1
		shift
		set -- "$@" "$first"
		round=$((round + 1))
	done
	trap - EXIT INT TERM
	echo
	summary "$dir/jitter.csv" "$dir/build.csv"
}

# ---------------------------------------------------------------- summary

summary() {
	if [ $# -eq 0 ]; then
		set -- "$dir"/*.csv
		[ "$own_dir" = "$dir" ] || [ ! -d "$own_dir" ] || set -- "$@" "$own_dir"/*.csv
	fi
	for f in "$@"; do
		[ -r "$f" ] || continue
		echo "$(basename "$f" .csv):"
		awk -F, '
		NR == 1 { for (i = 1; i <= NF; i++) name[i] = $i; cols = NF; next }
		{
			n[$1]++
			for (i = 7; i <= cols; i++) if ($i ~ /^-?[0-9.]+$/) { k = $1 SUBSEP i; v[k, ++c[k]] = $i + 0 }
		}
		END {
			for (l in n) {
				printf "  %s  (%d rows)\n", l, n[l]
				for (i = 7; i <= cols; i++) {
					k = l SUBSEP i; m = c[k]
					if (m == 0) continue
					for (a = 1; a <= m; a++) x[a] = v[k, a]
					for (a = 2; a <= m; a++) { t = x[a]; b = a - 1; while (b >= 1 && x[b] > t) { x[b + 1] = x[b]; b-- } x[b + 1] = t }
					r50 = int(0.50 * m + 0.999999); r95 = int(0.95 * m + 0.999999)
					printf "    %-22s median %-10s p95 %-10s n %d\n", name[i], x[r50], x[r95], m
				}
			}
		}' "$f"
	done
}

# ---------------------------------------------------------------- markers

mark() {
	[ $# -eq 1 ] || usage 2
	d=${XDG_RUNTIME_DIR:-/tmp}
	uptime_s > "$d/kombain-$1" 2>/dev/null
}

case ${1:-} in
boot) shift; boot "$@" ;;
idle) shift; idle "$@" ;;
jitter) shift; jitter "$@" ;;
build) shift; build "$@" ;;
game) shift; game "$@" ;;
battery) shift; battery "$@" ;;
sched) shift; sched "$@" ;;
summary) shift; summary "$@" ;;
mark) shift; mark "$@" ;;
-h|--help|help|'') usage 0 ;;
*) usage 2 ;;
esac
