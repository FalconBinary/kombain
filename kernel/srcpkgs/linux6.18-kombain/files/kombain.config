# kombain's changes to Void's x86_64 kernel config (files/x86_64-dotconfig, unchanged from
# void-packages at the commit in kernel/void-packages.commit). The template merges this file
# over it with scripts/kconfig/merge_config.sh, runs olddefconfig, and fails if a line below
# is not in the result. Everything not here is Void's: modules, module signing without
# enforcement (NVIDIA's unsigned modules load), BTF, HZ 1000, every mitigation, NR_CPUS 256.

# The kernel's own name. The template appends Void's _${revision}, so uname -r says
# 6.18.62-kombain_1 next to Void's 6.18.62_1: the files in /boot, the modules directory,
# the initramfs, the Limine entries and kombain-bench's default label all tell the two apart.
# The dash matters to the Limine hook: `sort -V` puts a name with a dash below the same
# version without one, and the hook takes the newest name without a dash as the default entry.
CONFIG_LOCALVERSION="-kombain"

# sched_ext: scheduling policies as BPF programs (Void's scx: scx_lavd, scx_bpfland; later
# UniVoidDistro's vh-sched), to be chosen per mode by measurement. The stock kernel has it
# off. What it depends on, Void already has on: BPF_SYSCALL, BPF_JIT and DEBUG_INFO_BTF.
CONFIG_SCHED_CLASS_EXT=y

# Full preemption as the build default: the desktop and games are what this machine does,
# and the Gaming entry already boots the stock kernel with preempt=full. PREEMPT_DYNAMIC
# stays on, so preempt=voluntary, preempt=lazy (x86 has ARCH_HAS_PREEMPT_LAZY) and
# preempt=none remain one boot parameter away, for kombain-bench to compare.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT_DYNAMIC=y
